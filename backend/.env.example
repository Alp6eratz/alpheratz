# Пример переменных окружения бэкенда LinguaVault.
# Скопируйте в .env или задайте в настройках сервера / Docker.

# Папка для базы SQLite, загруженных файлов и секретного ключа.
DATA_DIR=./data

# Подключение к БД. Пусто — SQLite в DATA_DIR. Пример для PostgreSQL:
# DATABASE_URL=postgresql+psycopg://lingua:password@localhost:5432/lingua
DATABASE_URL=

# Секретный ключ подписи токенов. ОБЯЗАТЕЛЬНО задайте длинную случайную строку в продакшене.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Срок действия токена входа в часах.
TOKEN_TTL_HOURS=168

# Код приглашения для регистрации администратора.
ADMIN_INVITE_CODE=LINGUA-ADMIN

# Администратор, создаваемый при первом запуске. Смените пароль!
ADMIN_EMAIL=admin@lingua.local
ADMIN_PASSWORD=admin12345

# Адреса фронтенда, которым разрешены запросы (через запятую).
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Максимальный размер загружаемого файла (МБ) и одного значения личного хранилища (МБ).
MAX_UPLOAD_MB=500
MAX_VAULT_VALUE_MB=10

# Папка со сборкой фронтенда — тогда бэкенд раздаёт и сайт на том же адресе.
# STATIC_DIR=../dist/apps/lingua/browser

# Адрес и порт сервера разработки (run.py).
HOST=127.0.0.1
PORT=8000
